---
import Landing from '../components/landing/Landing.astro';

const title = 'workmux - parallel AI agents in your terminal';
const description =
  'Terminal-first workflow for parallel AI agents using git worktrees';
const site = Astro.site!.href.replace(/\/$/, '');
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = `${site}/social-preview.png`;
---

<!doctype html>
<html lang="en-US" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/branch-icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="workmux" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="workmux terminal workflow" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link
      rel="preload"
      href="/fonts/inter-roman-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/mr-dafoe-the.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/iosevka-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // The theme the docs pages store, or the system's, set before first
      // paint.
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      })();
    </script>
  </head>
  <body>
    <Landing />
  </body>
</html>

<script>
  // Theme toggle, copy buttons and tab groups, delegated from the document.
  document.addEventListener('click', async (e) => {
    const target = e.target as Element;
    if (target.closest('[data-theme-toggle]')) {
      const next =
        document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('starlight-theme', next);
      return;
    }
    const copy = target.closest<HTMLElement>('[data-copy]');
    if (copy) {
      const panel = copy
        .closest('[data-tabs]')
        ?.querySelector('[data-panel]:not([hidden]) [data-cmd]');
      const text = panel?.textContent ?? copy.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text.trim());
      } catch {}
      copy.setAttribute('data-copied', '');
      clearTimeout(Number(copy.dataset.timer));
      copy.dataset.timer = String(
        setTimeout(() => copy.removeAttribute('data-copied'), 1600),
      );
      return;
    }
    const tab = target.closest<HTMLElement>('[data-tab]');
    const group = tab?.closest('[data-tabs]');
    if (!tab || !group) return;
    const own = (el: Element) => el.closest('[data-tabs]') === group;
    for (const t of group.querySelectorAll<HTMLElement>('[data-tab]')) {
      if (!own(t)) continue;
      const on = t.dataset.tab === tab.dataset.tab;
      t.toggleAttribute('data-active', on);
      t.setAttribute('aria-selected', String(on));
    }
    for (const p of group.querySelectorAll<HTMLElement>('[data-panel]')) {
      if (own(p)) p.hidden = p.dataset.panel !== tab.dataset.tab;
    }
  });
</script>

<style is:global>
  @font-face {
    font-family: Inter;
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/inter-roman-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-400-latin.woff2') format('woff2');
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-500-latin.woff2') format('woff2');
  }
  /* Mr Dafoe (SIL OFL 1.1) cut down to the letters of the headline's "The". */
  @font-face {
    font-family: 'Mr Dafoe';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/mr-dafoe-the.woff2') format('woff2');
    unicode-range: U+54, U+65, U+68;
  }
  /* Iosevka Term (every glyph one cell wide) subset to Latin, punctuation,
     arrows, box drawing, shapes, dingbats and braille: everything the live
     terminals draw. */
  @font-face {
    font-family: 'Iosevka Live';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/iosevka-regular.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Iosevka Live';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/iosevka-bold.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Iosevka Live';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/iosevka-italic.woff2') format('woff2');
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
  body {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  img,
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }
  [hidden] {
    display: none !important;
  }
</style>
