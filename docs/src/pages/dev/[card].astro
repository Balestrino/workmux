---
// The social preview image (public/social-preview.png) as a page, served by
// the dev server only. The live terminal shows its poster frame when motion
// is reduced, so render it with reduced motion at 1280x640, e.g.
//
//   agent-browser set viewport 1280 640 2
//   agent-browser set media light reduced-motion
//   agent-browser open <dev server>/dev/social-card/
//   agent-browser screenshot social-preview@2x.png
//
// then scale the capture down to 1280x640.
import LiveTmux from '../../components/landing/LiveTmux.astro';
import '../../components/landing/fonts.css';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { card: 'social-card' } }] : [];
}
---

<!doctype html>
<html lang="en-US" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>workmux social card</title>
  </head>
  <body>
    <main class="c">
      <div class="c-copy">
        <div class="c-brand">
          <img src="/branch-icon.svg" alt="" width="34" height="34" />
          workmux
        </div>
        <h1>
          <span class="c-the">The</span>tmux<sup>*</sup> workflow<br /><span
            >for parallel agents.</span
          >
        </h1>
        <p>
          Give every task its own git worktree and tmux window. See which agents
          are working or waiting on you.
        </p>
        <code><b>$</b> brew install raine/workmux/workmux</code>
      </div>
      <div class="c-frame">
        <div class="c-titlebar">
          <span class="c-lights"><i></i><i></i><i></i></span>
          ~/code/workmux
        </div>
        <LiveTmux />
      </div>
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    background: #f6f8f7;
  }
  body {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  [hidden] {
    display: none !important;
  }
</style>

<style>
  .c {
    position: relative;
    width: 1280px;
    height: 640px;
    overflow: hidden;
    color: #172325;
    background:
      radial-gradient(52rem 26rem at 78% -12%, #dff3ee, transparent 70%),
      #f6f8f7;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .c-copy {
    position: absolute;
    top: 64px;
    bottom: 64px;
    left: 72px;
    display: flex;
    flex-direction: column;
    width: 560px;
  }

  .c-brand {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 30px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  h1 {
    margin: auto 0 0;
    font-size: 72px;
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  h1 span {
    color: #7d8d8d;
  }

  /* The headline's article in a retro script, slanted against "tmux", as on
     the landing page. */
  h1 .c-the {
    display: inline-block;
    margin-right: 0.14em;
    color: #172325;
    font-family: 'Mr Dafoe', cursive;
    font-size: 0.8em;
    font-weight: 400;
    letter-spacing: 0;
    transform: rotate(-8deg);
  }

  sup {
    position: relative;
    top: -0.05em;
    margin-left: 0.02em;
    color: #087f70;
    font-size: 0.5em;
    font-weight: 600;
    line-height: 0;
  }

  p {
    margin: 28px 0 0;
    color: #526465;
    font-size: 23px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  code {
    align-self: flex-start;
    margin-top: auto;
    padding: 12px 18px;
    border: 1px solid #d8e2de;
    border-radius: 12px;
    background: #fff;
    font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    font-size: 19px;
  }

  code b {
    color: #7d8d8d;
    font-weight: 400;
  }

  /* The landing page's terminal, run off the card's right and bottom edges
     so the sidebar and the agent beside it fill the visible part. */
  .c-frame {
    position: absolute;
    top: 76px;
    left: 690px;
    width: 1040px;
    border: 1px solid #d8e2de;
    border-radius: 14px;
    background: #fbfbfa;
    box-shadow:
      0 1px 2px rgb(16 32 30 / 0.06),
      0 24px 60px -24px rgb(16 32 30 / 0.28);
    overflow: hidden;
  }

  .c-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    border-bottom: 1px solid #e2e2e0;
    color: #8a8a8a;
    background: #efefed;
    font-size: 13px;
  }

  .c-lights {
    position: absolute;
    left: 14px;
    display: flex;
    gap: 8px;
  }

  .c-lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .c-lights i:nth-child(2) {
    background: #febc2e;
  }

  .c-lights i:nth-child(3) {
    background: #28c840;
  }
</style>
